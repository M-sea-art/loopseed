{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/M-sea-art/loopseed/schemas/one-shotted/dialogue-event.schema.json",
  "title": "LoopSeed Creative Dialogue Event",
  "type": "object",
  "required": ["id", "run_id", "actor", "kind", "round", "summary", "effects", "advances", "created_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "actor": {"enum": ["user", "model"]},
    "kind": {"enum": ["seed", "synthesis", "question", "answer", "decision"]},
    "round": {"type": "integer", "minimum": 0},
    "summary": {"type": "string", "minLength": 1},
    "effects": {
      "type": "array",
      "items": {
        "enum": ["preserve", "clarify", "correct", "amplify", "complete", "continue", "offer_options"]
      },
      "uniqueItems": true
    },
    "advances": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "label", "consequence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "consequence": {"type": "string", "minLength": 1}
        }
      }
    },
    "recommended": {"type": "string"},
    "created_at": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"actor": {"const": "model"}}},
      "then": {
        "properties": {
          "effects": {"minItems": 1},
          "advances": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "question"}}},
      "then": {"required": ["options", "recommended"]}
    }
  ],
  "additionalProperties": true
}
