{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/M-sea-art/loopseed/schemas/one-shotted/state.schema.json",
  "title": "LoopSeed One-Shotted State",
  "type": "object",
  "required": [
    "schema_version",
    "loopseed_version",
    "mode",
    "run_id",
    "status",
    "phase",
    "round",
    "dialogue_rounds",
    "no_progress_rounds",
    "next_action"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "loopseed_version": {"type": "string"},
    "mode": {"const": "one-shotted"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["ACTIVE", "VERIFIED", "BLOCKED", "ABORTED"]},
    "phase": {"enum": ["CALIBRATE", "BIND", "PLAN", "IMPLEMENT", "VERIFY", "REPAIR", "FINALIZE"]},
    "round": {"type": "integer", "minimum": 0},
    "dialogue_rounds": {"type": "integer", "minimum": 0},
    "no_progress_rounds": {"type": "integer", "minimum": 0},
    "max_no_progress_rounds": {"type": "integer", "minimum": 1},
    "next_action": {"type": "string"},
    "true_blocker": {"type": ["object", "null"]},
    "scheduler_wait": {
      "type": ["object", "null"],
      "properties": {
        "task_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "reason": {"enum": ["HARD_DEPENDENCY", "JOIN"]},
        "fallback": {"type": "string", "minLength": 1},
        "declared_at": {"type": "string", "minLength": 1}
      },
      "required": ["task_ids", "reason", "fallback", "declared_at"]
    },
    "verification_binding": {
      "type": ["object", "null"],
      "required": [
        "schema_version", "binding_id", "generation", "evidence_ledger_count",
        "project_id", "candidate_commit", "artifact", "git_repository_detected",
        "actual_candidate_commit", "tracked_worktree_dirty", "bound_at"
      ],
      "properties": {
        "schema_version": {"const": "1.2"},
        "binding_id": {"type": "string", "minLength": 1},
        "generation": {"type": "integer", "minimum": 1},
        "evidence_ledger_count": {"type": "integer", "minimum": 0},
        "project_id": {"type": "string", "minLength": 1},
        "candidate_commit": {"type": "string", "minLength": 1},
        "artifact": {
          "type": "object",
          "required": ["path", "kind", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "kind": {"enum": ["file", "directory"]},
            "sha256": {"type": "string", "minLength": 64}
          }
        },
        "git_repository_detected": {"const": true},
        "actual_candidate_commit": {"type": "string", "minLength": 1},
        "tracked_worktree_dirty": {"const": false},
        "bound_at": {"type": "string", "minLength": 1}
      }
    },
    "verification_history": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
