{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/M-sea-art/loopseed/schemas/one-shotted/goal-contract.schema.json",
  "title": "LoopSeed One-Shotted Goal Contract",
  "type": "object",
  "required": [
    "schema_version",
    "loopseed_version",
    "mode",
    "run_id",
    "root_goal",
    "terminal_goal",
    "project_domain",
    "production_mode",
    "calibration",
    "authority",
    "completion_policy"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "loopseed_version": {"type": "string"},
    "mode": {"const": "one-shotted"},
    "run_id": {"type": "string", "minLength": 1},
    "root_goal": {"type": "string", "minLength": 1},
    "terminal_goal": {"type": "string", "minLength": 1},
    "project_domain": {"enum": ["game", "general"]},
    "production_mode": {"enum": ["undecided", "focused", "studio", "moonshot"]},
    "calibration": {
      "type": "object",
      "required": ["enabled", "status", "policy", "max_rounds", "dialogue_rounds"],
      "properties": {
        "enabled": {"type": "boolean"},
        "status": {"enum": ["OPEN", "LOCKED", "SKIPPED"]},
        "policy": {"const": "game-first-creative-co-director"},
        "max_rounds": {"type": "integer", "minimum": 1, "maximum": 8},
        "dialogue_rounds": {"type": "integer", "minimum": 0},
        "brief_id": {"type": ["string", "null"]},
        "locked_at": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "compiled_shot": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["brief_id", "path", "seed_intent_preserved"],
          "properties": {
            "brief_id": {"type": "string", "minLength": 1},
            "path": {"type": "string", "minLength": 1},
            "seed_intent_preserved": {"const": true}
          }
        }
      ]
    },
    "authority": {
      "type": "object",
      "required": ["user_instruction"],
      "properties": {
        "user_instruction": {"type": "string", "minLength": 1},
        "project_plan": {"type": "string"},
        "repository_instructions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "completion_policy": {"type": "object"}
  },
  "additionalProperties": true
}
