{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/M-sea-art/loopseed/schemas/one-shotted/machine-evidence.schema.json",
  "title": "LoopSeed Machine Evidence",
  "type": "object",
  "required": [
    "id", "schema_version", "kind", "producer", "run_id", "gate_id", "result", "actor", "summary",
    "command", "cwd", "started_at", "finished_at", "exit_code", "timed_out", "stdout_summary", "stderr_summary",
    "project_id", "candidate_commit", "actual_candidate_commit", "binding_id", "generation",
    "expected_artifact", "artifact_before", "artifact_after",
    "evidence_artifacts_before", "evidence_artifacts_after", "evidence_artifacts_stable",
    "tracked_worktree_dirty_before", "tracked_worktree_dirty_after",
    "unexpected_untracked_before", "unexpected_untracked_after",
    "git_repository_detected", "integrity_stable", "integrity_failure_reason", "created_at"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.2"},
    "kind": {"const": "MACHINE"},
    "producer": {"const": "loopseed.machine-evidence-runner"},
    "run_id": {"type": "string", "minLength": 1},
    "gate_id": {"type": "string", "minLength": 1},
    "result": {"enum": ["PASS", "FAIL"]},
    "actor": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "command": {"type": "string", "minLength": 1},
    "cwd": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "minLength": 1},
    "finished_at": {"type": "string", "minLength": 1},
    "exit_code": {"type": "integer"},
    "timed_out": {"type": "boolean"},
    "stdout_summary": {"type": "string"},
    "stderr_summary": {"type": "string"},
    "project_id": {"type": "string", "minLength": 1},
    "candidate_commit": {"type": "string", "minLength": 1},
    "actual_candidate_commit": {"type": ["string", "null"]},
    "binding_id": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "expected_artifact": {"type": "object"},
    "artifact_before": {"type": "object"},
    "artifact_after": {"type": "object"},
    "evidence_artifacts_before": {"type": "array", "items": {"type": "object"}},
    "evidence_artifacts_after": {"type": "array", "items": {"type": "object"}},
    "evidence_artifacts_stable": {"type": "boolean"},
    "tracked_worktree_dirty_before": {"const": false},
    "tracked_worktree_dirty_after": {"type": ["boolean", "null"]},
    "unexpected_untracked_before": {"type": "array", "maxItems": 0},
    "unexpected_untracked_after": {"type": "array", "items": {"type": "string"}},
    "git_repository_detected": {"const": true},
    "integrity_stable": {"type": "boolean"},
    "integrity_failure_reason": {"type": ["string", "null"]},
    "created_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
