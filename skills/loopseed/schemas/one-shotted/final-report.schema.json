{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/M-sea-art/loopseed/schemas/one-shotted/final-report.schema.json",
  "title": "LoopSeed One-Shotted Final Report",
  "type": "object",
  "required": [
    "schema_version",
    "loopseed_version",
    "mode",
    "run_id",
    "root_goal",
    "terminal_goal",
    "project_domain",
    "production_mode",
    "creative_brief_id",
    "verdict",
    "required_gates",
    "hard_gates",
    "quality_bar_gates",
    "gate_evidence",
    "verification_binding",
    "required_tasks",
    "open_blocking_defects",
    "finished_at"
  ],
  "properties": {
    "schema_version": {"const": "1.3"},
    "loopseed_version": {"type": "string", "minLength": 1},
    "mode": {"const": "one-shotted"},
    "run_id": {"type": "string", "minLength": 1},
    "root_goal": {"type": "string", "minLength": 1},
    "terminal_goal": {"type": "string", "minLength": 1},
    "project_domain": {"enum": ["game", "general"]},
    "production_mode": {"enum": ["focused", "studio", "moonshot"]},
    "creative_brief_id": {"type": ["string", "null"]},
    "verdict": {"const": "VERIFIED"},
    "required_gates": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "hard_gates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "quality_bar_gates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "gate_evidence": {
      "type": "object",
      "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}}
    },
    "verification_binding": {"type": "object"},
    "required_tasks": {"type": "array", "items": {"type": "string"}},
    "open_blocking_defects": {"type": "array", "maxItems": 0},
    "finished_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
