{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/M-sea-art/loopseed/schemas/one-shotted/final-report.schema.json",
  "title": "LoopSeed One-Shotted Final Report",
  "type": "object",
  "required": [
    "schema_version", "loopseed_version", "mode", "run_id", "root_goal",
    "verdict", "required_gates", "gate_evidence", "open_blocking_defects", "finished_at"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "loopseed_version": {"type": "string"},
    "mode": {"const": "one-shotted"},
    "run_id": {"type": "string", "minLength": 1},
    "root_goal": {"type": "string", "minLength": 1},
    "verdict": {"const": "VERIFIED"},
    "required_gates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "gate_evidence": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    },
    "binding": {"type": ["object", "null"]},
    "open_blocking_defects": {"type": "array", "maxItems": 0},
    "finished_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
