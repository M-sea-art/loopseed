{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/M-sea-art/loopseed/schemas/one-shotted/evidence-event.schema.json",
  "title": "LoopSeed One-Shotted Evidence Event",
  "type": "object",
  "required": ["id", "schema_version", "kind", "producer", "run_id", "gate_id", "result", "actor", "summary", "created_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.2"},
    "kind": {"enum": ["MACHINE", "ARTIFACT", "MANUAL"]},
    "producer": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "gate_id": {"type": "string", "minLength": 1},
    "result": {"enum": ["PASS", "FAIL"]},
    "actor": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "command": {"type": "string"},
    "exit_code": {"type": "integer"},
    "timed_out": {"type": "boolean"},
    "binding_id": {"type": ["string", "null"]},
    "generation": {"type": ["integer", "null"]},
    "project_id": {"type": ["string", "null"]},
    "candidate_commit": {"type": ["string", "null"]},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "created_at": {"type": "string"}
  },
  "additionalProperties": true
}
